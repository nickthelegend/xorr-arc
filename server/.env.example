# XORR executor on Arc. Copy to server/.env (gitignored). Every variable is read by server/src/env.ts.
XORR_NETWORK=arc-testnet            # arc-testnet | arc-mainnet (mainnet also needs ALLOW_MAINNET=yes)
ALLOW_MAINNET=
ARC_RPC_URL=                        # default: the network's public RPC; a local fork: http://127.0.0.1:9110
ARC_MAINNET_RPC_URL=                # where testnet mirrors and cirBTC Proof of Reserve read Chainlink mainnet
XORR_DEPLOYMENT=                    # default deployments/<network>.json
XORR_EXECUTOR_KEY=                  # the agent the owner grants; also council recorder and keeper. Needs USDC for gas.
XORR_EXECUTOR_KEY_FILE=             # or a file holding XORR_EXECUTOR_KEY=0x… (fork: .fork/keys.env)
PORT=9120
ALLOWED_ORIGINS=*                   # comma-separated web origins in production
KEEPER=on                           # off to run the API without the keeper loop
KEEPER_TICK_MS=30000
AUTOPILOT_EVERY_MS=600000
MAX_ROUND_USD=                      # largest single round (default 25 mainnet, 50 testnet)
MAX_GAP_BPS=150                     # Price Desk: most a quote may sit from Chainlink
XORR_DATA_DIR=server/data
FEATURE_GATEWAY=off                 # on: /gateway routes (Circle Gateway funding). Needs Circle's live API; untested on a fork.
FEATURE_CCTP=off                    # on: /cctp status route and the app's CCTP withdraw card. Needs Circle's Iris API.
